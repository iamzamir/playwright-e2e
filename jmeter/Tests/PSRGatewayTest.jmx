              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert Scope Unchanged by Round-trip" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def slurper = new groovy.json.JsonSlurper()
try {
  if (slurper.parseText(vars.get(&apos;poScopeBody&apos;)) != slurper.parseText(prev.getResponseDataAsString())) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;Scope differs from the body sent by POScope2&apos;)
  }
} catch (Exception e) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&apos;Could not compare scope: &apos; + e.message)
}
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
