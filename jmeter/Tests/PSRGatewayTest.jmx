            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Encode Calendar and Cycle Names for Path" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// __urlencode emits &apos;+&apos; for spaces, which is wrong inside a URL path
[&apos;poCalendarName&apos;, &apos;poCycleName&apos;].each { key -&gt;
  def value = vars.get(key) ?: &apos;NOT_FOUND&apos;
  vars.put(key + &apos;Enc&apos;, java.net.URLEncoder.encode(value, &apos;UTF-8&apos;).replace(&apos;+&apos;, &apos;%20&apos;))
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
