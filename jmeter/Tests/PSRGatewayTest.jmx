        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Set Gateway Entity IDs" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def gateway = (vars.get(&quot;GATEWAY_TYPE&quot;) ?: &quot;AZURE&quot;).toUpperCase()
if (gateway == &quot;GRAVITEE&quot;) {
  vars.put(&quot;aiProcessName&quot;, &quot;PSR1&quot;)
  vars.put(&quot;aiProcessEntityId&quot;, &quot;1f6ed2e8-c0af-4c3b-be42-a338768c2226&quot;)
  vars.put(&quot;aiProcessSourceId&quot;, &quot;7C2576C0-1F03-4F3A-BEEF-66AAC97D78CF&quot;)
  vars.put(&quot;aiSubprocessEntityId&quot;, &quot;08d2eefb-8016-4811-bf7c-21ab9d5d044e&quot;)
  vars.put(&quot;aiSubprocessSourceId&quot;, &quot;F2C92C20-AFC7-418B-B8F5-2F9C9603CCBB&quot;)
  vars.put(&quot;aiAssumptionEntityId&quot;, &quot;596f07a3-b446-412f-b744-5509f1a62f73&quot;)
  vars.put(&quot;aiAssumptionSourceId&quot;, &quot;0a20b541-a027-1eb3-81a0-8044986d015a&quot;)
  vars.put(&quot;aiAssumptionOrigin&quot;, &quot;9FBFAACC-A3E1-4E52-8531-8B317B9C2C24&quot;)
  vars.put(&quot;aiAssumptionSourceName&quot;, &quot;Assumption1&quot;)
} else {
  vars.put(&quot;aiProcessName&quot;, &quot;IntegratedBusinessPlanning&quot;)
  vars.put(&quot;aiProcessEntityId&quot;, &quot;5a61b5d3-4779-4101-8750-467899ae37a6&quot;)
  vars.put(&quot;aiProcessSourceId&quot;, &quot;9456BB1A-66D3-40CE-9D74-09124AC87F25&quot;)
  vars.put(&quot;aiSubprocessEntityId&quot;, &quot;92b982fa-adc0-4f90-9cf8-f9c137060ad3&quot;)
  vars.put(&quot;aiSubprocessSourceId&quot;, &quot;A9A4CE72-B389-4680-8A5B-FE61B004BAB1&quot;)
  vars.put(&quot;aiAssumptionEntityId&quot;, &quot;f80cf56e-01cc-49fb-81d1-a68fabecab53&quot;)
  vars.put(&quot;aiAssumptionSourceId&quot;, &quot;0a2300af-96f9-1095-8197-351d241b010c&quot;)
  vars.put(&quot;aiAssumptionOrigin&quot;, &quot;9456BB1A-66D3-40CE-9D74-09124AC87F25&quot;)
  vars.put(&quot;aiAssumptionSourceName&quot;, &quot;AssumptionPSR&quot;)
}
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="EntityViewMapping1: Map 30 Views for a Process" enabled="true">
