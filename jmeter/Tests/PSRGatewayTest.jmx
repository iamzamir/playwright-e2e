            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Copy Existing SCA type" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// CHANGE_MEASURE is a global seed type (pomgr.xml sca-insert-1), used only if no PSR SCA has a type
def type = &apos;CHANGE_MEASURE&apos;
try {
  def found = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).find { it.type }?.type
  if (found) {
    type = found
  }
} catch (Exception ignored) {
}
vars.put(&apos;perfScaType&apos;, type)
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
