            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert Scope Is JSON Object" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// dimensions and horizon are optional: an unfiltered process returns a sparse object such as {}
try {
  if (!(new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()) instanceof Map)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;Scope response is not a JSON object&apos;)
  }
} catch (Exception e) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&apos;Scope response is not valid JSON: &apos; + e.message)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Scope Body" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">vars.remove(&apos;poScopeBody&apos;)
def body = prev.getResponseDataAsString()?.trim()
if (prev.getResponseCode() == &apos;200&apos; &amp;&amp; body?.startsWith(&apos;{&apos;)) {
  vars.put(&apos;poScopeBody&apos;, body)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
