{
    "compilerOptions": {
      "sourceMap": false,
      "target": "es2019",
      "module": "commonjs",
      "removeComments": true,
      "noImplicitAny": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "strictPropertyInitialization": true,
      "strictNullChecks": true,
      "skipLibCheck": true,
      "types": ["node"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "reports", "test-results", "playwright-report"]
  }
