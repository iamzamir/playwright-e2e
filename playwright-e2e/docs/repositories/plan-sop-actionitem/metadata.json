{
  "name": "plan-sop-actionitem",
  "displayName": "Action Item Service",
  "org": "BY-Product-Development",
  "type": "backend-service",
  "language": "java",
  "runtime": "Java 21",
  "framework": "Spring Boot 3.5.16",
