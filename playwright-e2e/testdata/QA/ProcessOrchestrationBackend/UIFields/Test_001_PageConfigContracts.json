    "PROCESS_SUMMARY": { "pageId": "2", "entityName": "PROCESS" },
    "SUBPROCESS_LIST": { "pageId": "3", "entityName": "SUBPROCESS" },
    "SUBPROCESS_SUMMARY": { "pageId": "4", "entityName": "SUBPROCESS" },
    "PROCESS_FILTERS": { "pageId": "21", "entityName": "PROCESS" },
    "CALENDAR_LIST": { "pageId": "22", "entityName": "CALENDAR" },
    "CYCLE_LIST": { "pageId": "23", "entityName": "CYCLE" },
    "CALENDAR_DETAILS": { "pageId": "24", "entityName": "CALENDAR" },
