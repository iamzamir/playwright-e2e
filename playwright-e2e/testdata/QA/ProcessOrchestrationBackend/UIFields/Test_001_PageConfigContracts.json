{
  "_schema": {
    "ACCEPT_LANGUAGE": "string (required) - locale sent on every request so displayName is deterministic",
    "ALT_ACCEPT_LANGUAGE": "string (required) - second locale for the localisation check",
    "PROCESS_NAME": "string (required) - existing process whose id is read at runtime",
    "SUBPROCESS_NAME": "string (required) - existing subprocess of PROCESS_NAME whose id is read at runtime",
    "INVALID_PAGE_ID": "string (required) - non-numeric page id",
    "UNKNOWN_PAGE_ID": "string (required) - numeric page id that is not seeded",
    "ILLEGAL_ARGUMENT_ERROR_CODE": "string (required) - errorCode returned for a non-numeric page id",
    "PAGES": "object (required) - { <key>: { pageId: string, entityName: string } } for the seeded pages under test",
    "EXPECTED_FILTER_NAMES": "string[] (required) - sorted filter names on the process filters page",
    "EXPECTED_STATUS_FILTER_KEYS": "string[] (required) - sorted value keys of the status filter",
    "LIST_BASELINE": "object (required) - { '<pageId>:<entityName>': sorted field names }",
    "DETAIL_BASELINE": "object (required) - { '<pageId>:<entityName>': { '<groupName or _header>': sorted field names } }"
  },
  "ACCEPT_LANGUAGE": "en-US",
  "ALT_ACCEPT_LANGUAGE": "fr-FR",
